# ============================================================
# PNG2PPT / minerU-to-ppt - .gitignore
# ============================================================

# ----- 外部依赖（git submodule）-----
# px-image2pptx 改用 git submodule 管理
# clone 时: git clone --recurse-submodules https://github.com/sckall/image-to-ppt.git
# 已 clone: git submodule update --init --recursive

# ----- 虚拟环境 -----
.venv/
venv/
env/
ENV/
.python-version

# ----- 本地测试产物 / 调试文件 -----
tests_local/
*.bak
*.swp
*.swo
*~

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ----- 测试 / 覆盖率 -----
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
htmlcov/
*.cover
.hypothesis/
.pyre/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ----- 日志 -----
*.log
logs/
*.log.*

# ----- 用户私有 / IDE -----
.env
.env.*
!.env.example
secrets.yaml
*.key
*.pem
TODO.local.md
NOTES.local.md

# ----- IDE / 编辑器 -----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ----- 输出产物（用户跑出来的）-----
# 只忽略根目录的 output/ outputs/, examples/ 下的同名目录不受影响
/output/
/outputs/
*.pptx
!tests_local/README*  # 如果以后要加示例
